[sub_resource type="GDScript" id="GDScript_6soy1"]
script/source = "extends VehicleBody3D

@export var engine_power := 3000.0
@export var brake_force := 120.0
@export var handbrake_force := 500.0
@export var max_steering := 0.4
@export var drift_enabled := true

var throttle := 0.0
var steering_input := 0.0
var braking := false
var handbraking := false
var headlights := 0 # 0: Off, 1: Low, 2: High

var is_moving_forward := true  # Track movement direction

func _physics_process(delta):
	var accel = Input.get_action_strength(\"InGame_Accelerate\")
	var reverse = Input.get_action_strength(\"InGame_Reverse\")
	braking = accel > 0.0 and reverse > 0.0
	handbraking = Input.is_action_pressed(\"InGame_HandBrake\")

	# Adjust throttle based on input
	if reverse > 0.0 and accel == 0.0:
		throttle = -reverse * 0.5
		is_moving_forward = false
	elif accel > 0.0:
		throttle = accel
		is_moving_forward = true
	else:
		throttle = 0.0

	steering_input = (Input.get_action_strength(\"InGame_Steer.Left\") - Input.get_action_strength(\"InGame_Steer.Right\")) * max_steering

	# Handle horn, signals, and headlights
	if Input.is_action_just_pressed(\"InGame_Horn\"):
		print(\"Honk!\")
	if Input.is_action_just_pressed(\"InGame_Signals.Left\"):
		print(\"Left signal!\")
	if Input.is_action_just_pressed(\"InGame_Signals.Right\"):
		print(\"Right signal!\")
	if Input.is_action_just_pressed(\"InGame_HeadLights.ChangeMode\"):
		headlights = (headlights + 1) % 3
		print(\"Headlights:\", headlights)

	update_vehicle()
	rotate_wheel_meshes(delta)

func update_vehicle():
	get_node(\"WheelFL\").set(\"steering\", steering_input)
	get_node(\"WheelFR\").set(\"steering\", steering_input)

	apply_engine_force(engine_power * throttle)
	apply_brake(brake_force if braking else 0.0)

	var rear_brake = handbrake_force if drift_enabled and handbraking else 0.0
	get_node(\"WheelRL\").set(\"brake\", rear_brake)
	get_node(\"WheelRR\").set(\"brake\", rear_brake)

func apply_engine_force(force):
	for w in [\"WheelRL\", \"WheelRR\"]:
		get_node(w).set(\"engine_force\", force)

func apply_brake(force):
	for w in [\"WheelFL\", \"WheelFR\", \"WheelRL\", \"WheelRR\"]:
		get_node(w).set(\"brake\", force)

func rotate_wheel_meshes(delta):
	var velocity = linear_velocity
	var rotation_sign = 1 if is_moving_forward else -1  # Adjust based on the car's movement direction

	for wheel_name in [\"WheelFL\", \"WheelFR\", \"WheelRL\", \"WheelRR\"]:
		var wheel = get_node(wheel_name)
		if wheel.has_node(\"Mesh\"): # Ensure the mesh exists
			var mesh = wheel.get_node(\"Mesh\")
			var radius = wheel.wheel_radius
			var rpm = velocity.length() / (2.0 * PI * radius)
			var rotation_speed = rpm * 2.0 * PI * delta * rotation_sign * -1

			# Apply rotation speed based on movement direction
			mesh.rotate_x(rotation_speed)
"

[sub_resource type="GDScript" id="GDScript_axiq8"]
script/source = "extends Node3D

@export var target_path: NodePath
@export var follow_speed := 5.0
@export var mouse_sensitivity := 0.005
@export var zoom_speed := 1.2
@export var min_zoom := 3.0
@export var max_zoom := 20.0
@export var zoom_smoothness := 8.0

var yaw := 0.0
var pitch := 0.0
var zoom_target := 10.0
var zoom_current := 10.0
var target: Node3D = null

func _ready():
	target = get_node_or_null(target_path)
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

func _unhandled_input(event):
	if event is InputEventMouseMotion and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		yaw -= event.relative.x * mouse_sensitivity
		pitch -= event.relative.y * mouse_sensitivity
		pitch = clamp(pitch, -0.5, 0.5)

	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_WHEEL_UP:
			zoom_target = max(min_zoom, zoom_target / zoom_speed)
		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			zoom_target = min(max_zoom, zoom_target * zoom_speed)

func _process(delta):
	if not target:
		return

	# Smooth position follow
	global_position = global_position.lerp(target.global_transform.origin, delta * follow_speed)
	$SpringArm3D.position = target.global_transform.origin - global_position

	# Smooth zoom transition
	zoom_current = lerp(zoom_current, zoom_target, delta * zoom_smoothness)

	# Rotate SpringArm relative to target
	var spring_arm = $SpringArm3D
	if spring_arm:
		var base_rot = target.global_transform.basis.get_euler()
		spring_arm.rotation = Vector3(pitch, yaw, 0) + Vector3(0, base_rot.y, 0)
		spring_arm.spring_length = zoom_current
"

